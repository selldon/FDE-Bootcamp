ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# LLM_MODEL=claude-sonnet-5-5

# DemoStore's systems for this course run in containers outside this repo (test values, not secrets)
# Ledgerline, the ERP: a copy, and the read-only account its owner gave us
LEDGERLINE_DSN=localhost:1521/FREEPDB1
LEDGERLINE_USER=LL_READER
LEDGERLINE_PASSWORD=reader
# the carrier's nightly files on its SFTP server
CARRIER_HOST=127.0.0.1
CARRIER_PORT=2222
CARRIER_USER=demostore
CARRIER_PASSWORD=feed
# our own PostgreSQL: the order store
STORE_URL=postgresql://demostore:demostore@127.0.0.1:5432/product
# the one write Ledgerline's owner agreed to: return drafts into LL_RTN_REQ_STG
LEDGERLINE_WRITER_USER=LL_WRITER
LEDGERLINE_WRITER_PASSWORD=writer
# ServiceNow: approval tasks and hand-off cases
SERVICENOW_URL=http://127.0.0.1:8020
SERVICENOW_USER=fde_tasks
SERVICENOW_PASSWORD=tasks
# Confluence: the policy space POL (read only)
CONFLUENCE_URL=http://127.0.0.1:8040
