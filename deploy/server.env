# Settings of the server's containers (chat, shadow, jobs). Hosts are service names in the `systems` network.
# Everything below is a TEST value of the course's sandbox (the same ones as in sandbox/systems/compose.yaml), not a secret.
# The Anthropic key is NOT here: remote-deploy.sh reads it from SSM and passes it by name.
LEDGERLINE_DSN=ledgerline:1521/FREEPDB1
LEDGERLINE_USER=LL_READER
LEDGERLINE_PASSWORD=reader
LEDGERLINE_WRITER_USER=LL_WRITER
LEDGERLINE_WRITER_PASSWORD=writer
CARRIER_HOST=carrier
CARRIER_PORT=22
CARRIER_USER=demostore
CARRIER_PASSWORD=feed
STORE_URL=postgresql://demostore:demostore@ourdb:5432/product
SERVICENOW_URL=http://servicenow:8020
SERVICENOW_USER=fde_tasks
SERVICENOW_PASSWORD=tasks
SERVICENOW_READER_USER=fde_reader
SERVICENOW_READER_PASSWORD=reader
CONFLUENCE_URL=http://confluence:8040
# the server's clock is frozen at the day of the sandbox's carrier files (see docs/quick-fixes.md)
DEMOSTORE_NOW=2026-10-22T05:00:00+00:00
# TEST VALUE, labelled: a made-up key for the keyed hash of traces; the server holds only sandbox data
TRACE_HMAC_KEY=test-value-only-fde-course-sandbox-not-a-secret
