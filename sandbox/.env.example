ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# LLM_MODEL=claude-sonnet-5-5

# Ledgerline, the ERP: the read-only account on the copy (test values of the local sandbox)
LEDGERLINE_DSN=localhost:1521/FREEPDB1
LEDGERLINE_USER=LL_READER
LEDGERLINE_PASSWORD=reader
SERVICENOW_URL=http://127.0.0.1:8020
SERVICENOW_USER=fde_reader
SERVICENOW_PASSWORD=reader
CARRIER_HOST=127.0.0.1
CARRIER_PORT=2222
CARRIER_USER=demostore
CARRIER_PASSWORD=feed

# Mailpit: the one-time codes go out by SMTP; its web page and API show them (test values)
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAILPIT_URL=http://127.0.0.1:8025
# Atlas, the store platform (stand-in on 8030): catalog, prices, company contract prices
ATLAS_URL=http://127.0.0.1:8030
# our own PostgreSQL: the event queue (and later the order store)
OURDB_URL=postgresql://demostore:demostore@127.0.0.1:5432/assistant
# Ledgerline's staging table for return drafts: the writer account may only add drafts and read them (test values)
LEDGERLINE_WRITER_USER=LL_WRITER
LEDGERLINE_WRITER_PASSWORD=writer
# ServiceNow approval tasks: the integration account that opens and reads them (test values)
SERVICENOW_TASKS_USER=fde_tasks
SERVICENOW_TASKS_PASSWORD=tasks
# the Confluence stand-in (systems/confluence/sim.py): the policy pages, with the date each version applies from
CONFLUENCE_URL=http://127.0.0.1:8040
