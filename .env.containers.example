# What differs inside containers from .env (which stays as it is for the laptop). Copy to .env.containers and fill in.
# The later file wins, so only the changed names are here; keys and passwords stay in .env.
# Our containers join the network systems_default and reach DemoStore's systems by service name.
LEDGERLINE_DSN=ledgerline:1521/FREEPDB1
CARRIER_HOST=carrier
CARRIER_PORT=22
# the PostgreSQL password is part of this URL, so it is written here, in the file that is not committed
STORE_URL=postgresql://demostore:CHANGE-ME@ourdb:5432/product
# ServiceNow and Confluence run on this machine, on the ports in .env
SERVICENOW_URL=http://host.docker.internal:8020
CONFLUENCE_URL=http://host.docker.internal:8040
